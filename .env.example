# Public Supabase values (safe to expose in the browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Used only in SQL setup / docs — never put secrets in VITE_ variables
# Copy this Discord snowflake into platform_config via the SQL editor
# OWNER_DISCORD_ID=1438172505423478916

# Optional site URL used for OAuth redirects and share metadata
VITE_SITE_URL=http://localhost:5173
